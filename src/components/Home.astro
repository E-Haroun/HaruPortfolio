---
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Closing from './Closing.astro';
import Cases from '../islands/Cases';
import Path from '../islands/Path';
import Skills from '../islands/Skills';
import type { Lang } from '../data/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Layout lang={lang}>
  <Hero lang={lang} />
  <section class="block" id="work">
    <div class="wrap">
      <Cases lang={lang} client:idle />
    </div>
  </section>
  <section class="block" id="path">
    <div class="wrap">
      <Path lang={lang} client:visible />
    </div>
  </section>
  <section class="block" id="skills">
    <div class="wrap">
      <Skills lang={lang} client:visible />
    </div>
  </section>
  <Closing lang={lang} />
</Layout>
