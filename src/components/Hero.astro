---
import Guide from '../islands/Guide';
import MatchLab from '../islands/MatchLab';
import { ui, type Lang } from '../data/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<div class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap">
    <p class="status">
      <i></i>
      {t['hero.status']}
    </p>
    <h1 set:html={t['hero.title']} />
    <div class="hero-row">
      <div>
        <p class="lead">{t['hero.lead']}</p>
        <div class="facts">
          <span set:html={t['hero.f1']} />
          <span set:html={t['hero.f2']} />
          <span set:html={t['hero.f3']} />
        </div>
      </div>
      <Guide lang={lang} client:idle />
    </div>
    <MatchLab lang={lang} client:load />
  </div>
</div>
