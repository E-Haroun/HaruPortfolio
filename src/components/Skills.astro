---
import { SK } from '../data/skills';
import { L, ui, type Lang } from '../data/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="block" id="skills">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow">{t['skills.eyebrow']}</div>
        <h2>{t['skills.title']}</h2>
      </div>
      <p>{t['skills.hint']}</p>
    </div>
    <div class="skills">
      {SK.map((group) => (
        <div class="sk">
          <h3>{group.g[lang]}</h3>
          <div class="chips">
            {group.items.map((it) => (
              <button type="button" class="chip" data-where={it.where.join(', ')} aria-pressed="false">
                {L(it.label, lang)}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="proof" id="proof" aria-live="polite">
      {t['skills.idle']}
    </div>
  </div>
</section>
