---
import { STORY } from '../data/extras';
import { ui, type Lang } from '../data/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="block" id="proof">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow">{t['proof.eyebrow']}</div>
        <h2>{t['proof.title']}</h2>
      </div>
    </div>

    <div class="story">
      <!-- The incident told in plain words, one step at a time -->
      <ol class="steps">
        {STORY.map((step) => (
          <li class="reveal">
            <h3>{step.title[lang]}</h3>
            <p>{step.text[lang]}</p>
          </li>
        ))}
      </ol>

      <!-- The same story as a step chart: only the three measured levels, no invented points -->
      <figure class="incident reveal">
        <figcaption class="bar">
          <span>{t['inc.title']}</span>
          <span class="sev">{t['inc.sev']}</span>
        </figcaption>
        <div class="chart">
          <svg viewBox="0 0 360 160" role="img" aria-label={t['inc.chart']}>
            <g stroke="var(--line)" stroke-width="1">
              <line x1="40" y1="34" x2="350" y2="34"></line>
              <line x1="40" y1="130" x2="350" y2="130"></line>
            </g>
            <g class="axis">
              <text x="34" y="37" text-anchor="end">
                70 s
              </text>
              <text x="34" y="133" text-anchor="end">
                0 s
              </text>
              <text x="82" y="150" text-anchor="middle">
                {t['inc.before']}
              </text>
              <text x="195" y="150" text-anchor="middle">
                {t['inc.during']}
              </text>
              <text x="307" y="150" text-anchor="middle">
                {t['inc.after']}
              </text>
            </g>
            <rect x="125" y="34" width="140" height="96" fill="var(--signal-soft)"></rect>
            <polyline
              class="trace"
              pathLength="1"
              fill="none"
              stroke="var(--accent)"
              stroke-width="2.5"
              stroke-linejoin="round"
              points="40,122 125,122 125,34 265,34 265,122 350,122"
            ></polyline>
            <g class="val" text-anchor="middle">
              <text x="82" y="112">
                ≈ 6 s
              </text>
              <text x="195" y="24">
                ≈ 70 s
              </text>
              <text x="307" y="112">
                ≈ 6 s
              </text>
            </g>
          </svg>
        </div>
      </figure>
    </div>
  </div>
</section>
