---
import '@fontsource-variable/familjen-grotesk';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ui, type Lang } from '../data/ui';
import { PROFILE } from '../data/extras';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paths = { fr: `${base}/`, en: `${base}/en/` };
const abs = (path: string) => new URL(path, Astro.site).href;
const sections = ['work', 'path', 'skills', 'match', 'faq', 'contact'] as const;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  jobTitle: t['meta.job'],
  description: t['meta.description'],
  url: abs(paths[lang]),
  email: `mailto:${PROFILE.email}`,
  sameAs: [PROFILE.linkedin],
  address: { '@type': 'PostalAddress', addressCountry: 'FR' },
  knowsLanguage: ['fr', 'en', 'ar', 'de'],
  worksFor: { '@type': 'Organization', name: 'HPDIA' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'ENSAM Casablanca' },
    { '@type': 'CollegeOrUniversity', name: 'UTBM' },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t['meta.title']}</title>
    <meta name="description" content={t['meta.description']} />
    <link rel="canonical" href={abs(paths[lang])} />
    <link rel="alternate" hreflang="fr" href={abs(paths.fr)} />
    <link rel="alternate" hreflang="en" href={abs(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(paths.fr)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#F2F4F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0F17" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={PROFILE.name} />
    <meta property="og:title" content={t['meta.title']} />
    <meta property="og:description" content={t['meta.description']} />
    <meta property="og:url" content={abs(paths[lang])} />
    <meta property="og:image" content={abs(`${base}/og.png`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t['meta.title']} />
    <meta name="twitter:description" content={t['meta.description']} />
    <meta name="twitter:image" content={abs(`${base}/og.png`)} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- Apply the remembered theme before first paint -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('he-theme');
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {
        // storage blocked: fall back to the OS preference
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#top">
      {t.skip}
    </a>
    <div id="progress" aria-hidden="true"></div>

    <header class="top">
      <div class="wrap">
        <a class="mark" href="#top">
          <b>HE</b>
          <span>{PROFILE.name}</span>
        </a>
        <nav class="main" aria-label={t['nav.label']}>
          {sections.map((s) => (
            <a href={`#${s}`}>{t[`nav.${s}`]}</a>
          ))}
        </nav>
        <div class="tools">
          <div class="lang" role="group" aria-label="Langue / Language">
            <a href={paths.fr} hreflang="fr" lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>
              FR
            </a>
            <a href={paths.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>
              EN
            </a>
          </div>
          <button type="button" class="theme" id="theme" aria-label={t.theme} title={t.theme}>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer>
      <div class="wrap">{t.footer}</div>
    </footer>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
